# Copy to .env on the DigitalOcean droplet, then fill in real secrets from your local .env.
# Never commit real tokens — GitHub push protection will block them.
# Required for: docker compose -f docker-compose.prod.yaml up -d --build

DEBUG=False
SECRET_KEY=replace-with-a-long-random-string
TIME_ZONE=Asia/Kolkata

# IP-only for now (replace if your droplet IP changes)
ALLOWED_HOSTS=people.thegeekonomy.com,206.189.139.171,localhost,127.0.0.1,horilla-nginx
CSRF_TRUSTED_ORIGINS=https://people.thegeekonomy.com,http://people.thegeekonomy.com,http://206.189.139.171

# Database (used by Postgres container + Django)
POSTGRES_DB=horilla
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DB_INIT_PASSWORD=replace-with-db-init-password

# True when using HTTPS via Cloudflare; False only for plain HTTP IP tests
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Resend (preferred). When set, app sends mail via Resend API instead of SMTP.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Geekonomy HRMS <hr@thegeekonomy.com>
HR_EMAIL=hr@thegeekonomy.com

# SMTP fallback (ignored while RESEND_API_KEY is set)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

SLACK_BOT_TOKEN=
CRM_API_KEY=

# Microsoft Teams Online/Offline (Graph Presence API)
# Azure app: Presence.Read.All + User.Read.All (admin consent)
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://www.linkedin.com/developers/tools/oauth/redirect

# 2GB droplet defaults
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
